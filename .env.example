# AIWorld 环境变量示例
AIWORLD_HOST=127.0.0.1
AIWORLD_PORT=8765

# 访问令牌：绑非回环地址时，非本机访问 /api/* 必须带 Authorization: Bearer <token>。
# 留空 = 本机单人使用（回环地址一律放行）。
# 想让局域网设备访问：把上面改成 0.0.0.0，这里填一串长随机值，然后在那台设备上
# 打开 http://<本机IP>:8765/?token=<令牌> 一次（令牌会被前端记住）。
# ⚠️ 明文 HTTP，只在可信局域网这么用。
AIWORLD_AUTH_TOKEN=
# true（默认）= 非本机必须带令牌；false = 整体关掉鉴权
# （C 方案：绑全网卡 + 防火墙限源网段，明确接受无鉴权时用 false）
AIWORLD_REQUIRE_AUTH_FOR_NON_LOCAL=true

# OpenAI 兼容网关（Ollama / LM Studio / DeepSeek / Qwen 等）
AIWORLD_LLM_BASE_URL=http://127.0.0.1:11434/v1
AIWORLD_LLM_API_KEY=ollama
AIWORLD_LLM_TIMEOUT_SECONDS=90
AIWORLD_MODEL_MAIN=qwen2.5:7b
AIWORLD_MODEL_CHEAP=qwen2.5:7b   # 辅助模型：质检/审计/分类/落卡草稿默认

# 辅助模型的**独立出口**（2026-09-20）：不填 = 跟随上面那一套（地址与密钥都跟随）。
# 两侧可以完全不同：主模型走付费 API、辅助模型走本地 ollama 是最常见的配法。
# AIWORLD_CHEAP_BASE_URL=https://api.deepseek.com/v1
# AIWORLD_CHEAP_API_KEY=sk-...

# 可选单项覆盖
# AIWORLD_MODEL_DIRECTOR=
# AIWORLD_MODEL_ACTOR=
# AIWORLD_MODEL_STORY=
# AIWORLD_MODEL_QC=
# AIWORLD_MODEL_AUDIT=
# AIWORLD_MODEL_CLASSIFY=

AIWORLD_CANDIDATE_TTL_DAYS=7
AIWORLD_AUDIT_ENABLED=true
AIWORLD_DATA_DIR=data